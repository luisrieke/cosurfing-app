# ---------------------------------------------------------------------------
# Client (bundled into the app and website). Never put secrets here.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://xijiyqstanafqjmfllsm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the website. Used for links in emails and for Stripe return URLs.
EXPO_PUBLIC_SITE_URL=https://cosurfing.app

# Show example places (seeded with is_example = true). Keep false in production.
EXPO_PUBLIC_SHOW_EXAMPLE_PLACES=false

# RevenueCat public SDK keys (iOS / Android). Leave empty until configured.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Set to "stripe" once Stripe is configured on the server. Leave empty to show
# the clearly labelled development paywall instead.
EXPO_PUBLIC_WEB_PAYMENTS=

# Tally form URL (https://tally.so/r/...) for the Plus waiting list. While set, the
# paywall on every platform links to this form instead of a checkout. The form gets
# email, user_id, plan and platform as URL parameters (add them as hidden fields).
EXPO_PUBLIC_PLUS_WAITLIST_URL=

# Tally form for venue owners ("Do you run this place?" on every place page).
# Defaults to https://tally.so/r/o9Djeb. Gets place_id, place_slug, place_name, city,
# user_id and email as URL parameters (hidden fields in the form).
EXPO_PUBLIC_OWNER_FORM_URL=

# Tally form for the Early Contributors coffee program (/free-coffee), https://tally.so/r/...
# Opened with token, email, base, place and share as URL parameters (hidden fields in the
# form; see docs/free-coffee.md). Until set, participants see "submission form not ready yet".
EXPO_PUBLIC_COFFEE_FORM_URL=

# Google Maps key for Android builds only (iOS uses Apple Maps, web uses MapLibre).
GOOGLE_MAPS_ANDROID_API_KEY=

# EAS project id (set after `eas init`).
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server (Supabase Edge Function secrets). Set with:
#   supabase secrets set --env-file supabase/.env
# or in the Supabase dashboard under Edge Functions -> Secrets.
# Never ship these to the client.
# ---------------------------------------------------------------------------

# SITE_URL=https://cosurfing.app
# RESEND_API_KEY=
# RESEND_FROM="Luis from Cosurfing <luis@cosurfing.app>"
# RESEND_REPLY_TO=luis@cosurfing.app
# When set, every email is redirected to this address (safe testing).
# EMAIL_SANDBOX_TO=
# Secret used to hash IPs for rate limiting.
# RATE_LIMIT_SALT=

# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_WEEKLY=
# STRIPE_PRICE_ID_YEARLY=
# STRIPE_WEBHOOK_SECRET=

# REVENUECAT_WEBHOOK_AUTH=

# Allow the development-only simulated Plus toggle (never enable in production).
# ALLOW_DEV_ENTITLEMENTS=false
